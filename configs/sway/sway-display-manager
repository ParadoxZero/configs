#!/usr/bin/env python3
"""Sway display profile manager.

Detects connected outputs, matches them to a saved profile, and applies
the output configuration via swaymsg.

Usage:
  sway-display-manager           apply matching profile (or create default)
  sway-display-manager --reset   delete all profiles and re-enable all outputs
  sway-display-manager --edit    open TUI to edit saved profiles
"""

import argparse
import curses
import json
import subprocess
import sys
from pathlib import Path

STATE_DIR = Path.home() / ".local" / "state" / "swaydisplay"
PROFILES_FILE = Path.home() / ".config" / "sway" / "display_profiles.json"
CURRENT_CONF = STATE_DIR / "current.conf"

SNAP_DIST = 20  # pixels — how close an edge must be to snap

FIELDS = ["enabled", "x", "y", "resolution", "refresh_hz", "scale"]
FIELD_LABELS = {
    "enabled":    "Enabled",
    "x":          "Position X",
    "y":          "Position Y",
    "resolution": "Resolution",
    "refresh_hz": "Refresh (Hz)",
    "scale":      "Scale",
}


# ── sway / data helpers ───────────────────────────────────────────────────────

def swaymsg(*args):
    result = subprocess.run(["swaymsg", *args], capture_output=True, text=True)
    return result.stdout, result.returncode == 0


def get_outputs():
    out, ok = swaymsg("-t", "get_outputs")
    if not ok:
        return []
    try:
        return json.loads(out)
    except json.JSONDecodeError:
        return []


def profile_key(outputs):
    return "+".join(sorted(o["name"] for o in outputs))


def default_output_cfg(output):
    mode = output.get("current_mode") or {}
    rect = output.get("rect") or {}
    refresh_mhz = mode.get("refresh", 0)
    return {
        "enabled": output.get("dpms", True),
        "x": rect.get("x", 0),
        "y": rect.get("y", 0),
        "width": mode.get("width"),
        "height": mode.get("height"),
        "refresh_hz": round(refresh_mhz / 1000, 3) if refresh_mhz else None,
        "scale": output.get("scale", 1.0),
    }


def load_data():
    if PROFILES_FILE.exists():
        with open(PROFILES_FILE) as f:
            return json.load(f)
    return {"profiles": {}}


def save_data(data):
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    with open(PROFILES_FILE, "w") as f:
        json.dump(data, f, indent=2)


def output_cmd(name, cfg):
    if not cfg.get("enabled", True):
        return f"output {name} disable"
    parts = [f"output {name} enable"]
    if cfg.get("width") and cfg.get("height"):
        res = f"{cfg['width']}x{cfg['height']}"
        if cfg.get("refresh_hz"):
            res += f"@{cfg['refresh_hz']:.3f}Hz"
        parts.append(f"resolution {res}")
    if cfg.get("x") is not None and cfg.get("y") is not None:
        parts.append(f"position {cfg['x']},{cfg['y']}")
    if cfg.get("scale"):
        parts.append(f"scale {cfg['scale']}")
    return " ".join(parts)


def apply_profile(profile):
    cmds = [output_cmd(n, c) for n, c in profile["outputs"].items()]
    for cmd in cmds:
        swaymsg(cmd)
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    with open(CURRENT_CONF, "w") as f:
        f.write(f"# Profile: {profile['name']}\n")
        f.write("\n".join(cmds) + "\n")


def do_apply():
    outputs = get_outputs()
    if not outputs:
        print("No outputs detected (is WAYLAND_DISPLAY set?)", file=sys.stderr)
        sys.exit(1)
    key = profile_key(outputs)
    data = load_data()
    if key not in data["profiles"]:
        data["profiles"][key] = {
            "name": key,
            "outputs": {o["name"]: default_output_cfg(o) for o in outputs},
        }
        save_data(data)
        print(f"Created profile for: {key}", flush=True)
    profile = data["profiles"][key]
    apply_profile(profile)
    print(f"Applied: {profile['name']}", flush=True)


def do_reset():
    outputs = get_outputs()
    if not outputs:
        print("No outputs detected (is WAYLAND_DISPLAY set?)", file=sys.stderr)
        sys.exit(1)
    for o in outputs:
        swaymsg(f"output {o['name']} enable")
    if PROFILES_FILE.exists():
        PROFILES_FILE.write_text(json.dumps({"profiles": {}}, indent=2))
    print("Reset: all outputs enabled, all profiles cleared.", flush=True)


# ── TUI colours ───────────────────────────────────────────────────────────────

C_HDR = 1; C_SEL = 2; C_DIM = 3; C_KEY = 4
C_YEL = 5; C_GRN = 6; C_RED = 7


def init_colors():
    curses.start_color()
    curses.use_default_colors()
    curses.init_pair(C_HDR, curses.COLOR_BLACK,  curses.COLOR_CYAN)
    curses.init_pair(C_SEL, curses.COLOR_BLACK,  curses.COLOR_WHITE)
    curses.init_pair(C_DIM, 8,                   -1)
    curses.init_pair(C_KEY, curses.COLOR_CYAN,   -1)
    curses.init_pair(C_YEL, curses.COLOR_YELLOW, -1)
    curses.init_pair(C_GRN, curses.COLOR_GREEN,  -1)
    curses.init_pair(C_RED, curses.COLOR_RED,    -1)


# ── TUI primitives ────────────────────────────────────────────────────────────

def header(win, text):
    _, w = win.getmaxyx()
    win.attron(curses.color_pair(C_HDR) | curses.A_BOLD)
    win.addstr(0, 0, text.center(w)[:w])
    win.attroff(curses.color_pair(C_HDR) | curses.A_BOLD)


def footer(win, hints):
    h, w = win.getmaxyx()
    s = "  ".join(f"[{k}]{v}" for k, v in hints)
    win.attron(curses.color_pair(C_KEY))
    win.addstr(h - 1, 0, s[:w])
    win.attroff(curses.color_pair(C_KEY))


def text_input(stdscr, prompt, default=""):
    h, w = stdscr.getmaxyx()
    dw = min(64, w - 4)
    win = curses.newwin(5, dw, (h - 5) // 2, (w - dw) // 2)
    curses.curs_set(1)
    buf, pos = list(default), len(default)
    while True:
        win.clear(); win.box()
        win.addstr(1, 2, prompt[:dw - 4])
        disp = "".join(buf)
        win.addstr(2, 2, disp[:dw - 5].ljust(dw - 5))
        win.move(2, 2 + min(pos, dw - 6))
        win.refresh()
        c = win.getch()
        if c in (10, 13):
            curses.curs_set(0); return "".join(buf)
        if c == 27:
            curses.curs_set(0); return None
        if c in (curses.KEY_BACKSPACE, 127, 8) and pos > 0:
            buf.pop(pos - 1); pos -= 1
        elif c == curses.KEY_LEFT  and pos > 0:        pos -= 1
        elif c == curses.KEY_RIGHT and pos < len(buf): pos += 1
        elif 32 <= c < 127:
            buf.insert(pos, chr(c)); pos += 1


def flash_msg(stdscr, msg, color=C_GRN):
    h, w = stdscr.getmaxyx()
    stdscr.attron(curses.color_pair(color) | curses.A_BOLD)
    stdscr.addstr(h // 2, max(0, (w - len(msg)) // 2), msg[:w])
    stdscr.attroff(curses.color_pair(color) | curses.A_BOLD)
    stdscr.refresh()
    curses.napms(1200)


# ── Arrange-display helpers ───────────────────────────────────────────────────

def _snap_edges(cfg, other):
    """Snap cfg x/y to other's edges when within SNAP_DIST pixels."""
    mw = cfg.get("width") or 1920
    mh = cfg.get("height") or 1080
    ow = other.get("width") or 1920
    oh = other.get("height") or 1080
    mx, my = cfg.get("x", 0), cfg.get("y", 0)
    ox, oy = other.get("x", 0), other.get("y", 0)

    for m_edge, o_edge, offset in [
        (mx,      ox,      0),
        (mx,      ox + ow, 0),
        (mx + mw, ox,      -mw),
        (mx + mw, ox + ow, -mw),
    ]:
        if abs(m_edge - o_edge) <= SNAP_DIST:
            cfg["x"] = o_edge + offset
            break

    for m_edge, o_edge, offset in [
        (my,      oy,      0),
        (my,      oy + oh, 0),
        (my + mh, oy,      -mh),
        (my + mh, oy + oh, -mh),
    ]:
        if abs(m_edge - o_edge) <= SNAP_DIST:
            cfg["y"] = o_edge + offset
            break


def _draw_box(stdscr, row, col, bh, bw, label, attr, sh, sw):
    """Draw a labelled box, clipping to (sh, sw)."""
    def put(r, c, s):
        if 0 <= r < sh - 1 and 0 <= c < sw:
            try:
                stdscr.addstr(r, c, s[:max(0, sw - c)], attr)
            except curses.error:
                pass

    if bh < 2 or bw < 4:
        put(row, col, f"[{label}]"[:max(1, bw)])
        return

    put(row,          col, "┌" + "─" * (bw - 2) + "┐")
    for r in range(row + 1, row + bh - 1):
        put(r, col,          "│")
        if bw > 2:
            put(r, col + 1,  " " * (bw - 2))
        put(r, col + bw - 1, "│")
    mid_r = row + bh // 2
    short = label[:bw - 2]
    put(mid_r, col + max(1, (bw - len(short)) // 2), short)
    put(row + bh - 1, col, "└" + "─" * (bw - 2) + "┘")


def screen_arrange(stdscr, data, key):
    """Visual drag-and-drop display layout screen."""
    profile   = data["profiles"][key]
    out_names = list(profile["outputs"].keys())
    sel       = 0
    snap_on   = True
    STEP      = 10
    STEP_LG   = 100

    while True:
        stdscr.erase()
        sh, sw = stdscr.getmaxyx()
        header(stdscr, f" Arrange — {profile['name']} ")

        cfgs = profile["outputs"]

        # Pixel bounding box across all outputs
        def pw(c): return c.get("width") or 1920
        def ph(c): return c.get("height") or 1080

        px_min = min(c.get("x", 0)          for c in cfgs.values())
        py_min = min(c.get("y", 0)          for c in cfgs.values())
        px_max = max(c.get("x", 0) + pw(c)  for c in cfgs.values())
        py_max = max(c.get("y", 0) + ph(c)  for c in cfgs.values())
        span_x = max(px_max - px_min, 1)
        span_y = max(py_max - py_min, 1)

        PAD       = 2
        canvas_h  = max(4, sh - 8)
        canvas_w  = max(8, sw - 4)
        scale     = min(canvas_w / span_x, canvas_h / span_y)

        def scr(px, py):
            return (
                PAD + 1 + int((py - py_min) * scale),
                PAD     + int((px - px_min) * scale),
            )

        for i, name in enumerate(out_names):
            cfg = cfgs[name]
            r, c = scr(cfg.get("x", 0), cfg.get("y", 0))
            bw   = max(4, int(pw(cfg) * scale))
            bh   = max(2, int(ph(cfg) * scale))
            if i == sel:
                attr = curses.color_pair(C_SEL) | curses.A_BOLD
            elif not cfg.get("enabled", True):
                attr = curses.color_pair(C_DIM)
            else:
                attr = curses.color_pair(C_YEL)
            _draw_box(stdscr, r, c, bh, bw, name, attr, sh, sw)

        # Status: selected display info
        sel_name = out_names[sel]
        sel_cfg  = cfgs[sel_name]
        snap_str = "on" if snap_on else "off"
        info = (f" {sel_name}:  x={sel_cfg.get('x', 0):5d}  y={sel_cfg.get('y', 0):5d}"
                f"   {pw(sel_cfg)}x{ph(sel_cfg)}   snap={snap_str} ")
        try:
            stdscr.addstr(sh - 4, 0, info[:sw], curses.color_pair(C_YEL) | curses.A_BOLD)
        except curses.error:
            pass

        footer(stdscr, [
            ("Tab", "Next display"), ("↑↓←→", f"±{STEP}px"),
            ("hjkl", "±1px"), ("HJKL", f"±{STEP_LG}px"),
            ("N", "Snap"), ("S", "Save"), ("A", "Apply"), ("Esc", "Back"),
        ])
        stdscr.refresh()

        c_key = stdscr.getch()
        cfg   = cfgs[out_names[sel]]

        def move(dx, dy):
            cfg["x"] = cfg.get("x", 0) + dx
            cfg["y"] = cfg.get("y", 0) + dy
            if snap_on:
                for other in out_names:
                    if other != out_names[sel]:
                        _snap_edges(cfg, cfgs[other])

        if   c_key == 27:                      return
        elif c_key == ord('\t'):               sel = (sel + 1) % len(out_names)
        elif c_key == curses.KEY_LEFT:         move(-STEP, 0)
        elif c_key == curses.KEY_RIGHT:        move( STEP, 0)
        elif c_key == curses.KEY_UP:           move(0, -STEP)
        elif c_key == curses.KEY_DOWN:         move(0,  STEP)
        elif c_key == ord('h'):                move(-1,      0)
        elif c_key == ord('l'):                move( 1,      0)
        elif c_key == ord('k'):                move(0,      -1)
        elif c_key == ord('j'):                move(0,       1)
        elif c_key == ord('H'):                move(-STEP_LG, 0)
        elif c_key == ord('L'):                move( STEP_LG, 0)
        elif c_key == ord('K'):                move(0, -STEP_LG)
        elif c_key == ord('J'):                move(0,  STEP_LG)
        elif c_key in (ord('n'), ord('N')):    snap_on = not snap_on
        elif c_key in (ord('s'), ord('S')):
            save_data(data)
            flash_msg(stdscr, " Saved! ")
            return
        elif c_key in (ord('a'), ord('A')):
            save_data(data)
            apply_profile(profile)
            flash_msg(stdscr, f" Applied: {profile['name']} ")


# ── Profile list screen ───────────────────────────────────────────────────────

def screen_profiles(stdscr, data):
    sel = 0
    while True:
        stdscr.erase()
        h, w = stdscr.getmaxyx()
        header(stdscr, " Sway Display Profiles ")
        keys = list(data["profiles"].keys())
        sel = max(0, min(sel, len(keys) - 1))

        if keys:
            for i, k in enumerate(keys):
                row = 2 + i
                if row >= h - 2:
                    break
                p = data["profiles"][k]
                name = p.get("name", k)
                displays = k.replace("+", " + ")
                if i == sel:
                    stdscr.attron(curses.color_pair(C_SEL) | curses.A_BOLD)
                    stdscr.addstr(row, 0, f" {name:<28} {displays}"[:w])
                    stdscr.attroff(curses.color_pair(C_SEL) | curses.A_BOLD)
                else:
                    stdscr.attron(curses.color_pair(C_YEL))
                    stdscr.addstr(row, 0, f" {name:<28}")
                    stdscr.attroff(curses.color_pair(C_YEL))
                    stdscr.addstr(f" {displays}"[:max(0, w - 29)])
        else:
            stdscr.addstr(h // 2, max(0, (w - 22) // 2), "  No profiles saved yet  ")

        footer(stdscr, [("↑↓", "Nav"), ("⏎", "Edit"), ("P", "Arrange"),
                        ("A", "Apply"), ("N", "New"), ("D", "Del"),
                        ("R", "Rename"), ("Q", "Quit")])
        stdscr.refresh()
        c = stdscr.getch()

        if c in (ord('q'), ord('Q'), 27):
            return None, None
        if c in (ord('n'), ord('N')):
            _new_profile(stdscr, data)
            continue
        if not keys:
            continue
        k = keys[sel]
        if   c == curses.KEY_UP:   sel = max(0, sel - 1)
        elif c == curses.KEY_DOWN: sel = min(len(keys) - 1, sel + 1)
        elif c in (10, 13):        return "edit", k
        elif c in (ord('p'), ord('P')): return "arrange", k
        elif c in (ord('a'), ord('A')): return "apply", k
        elif c in (ord('r'), ord('R')):
            name = text_input(stdscr, "Rename profile:", data["profiles"][k]["name"])
            if name:
                data["profiles"][k]["name"] = name
                save_data(data)
        elif c in (ord('d'), ord('D')):
            del data["profiles"][k]
            save_data(data)
            sel = max(0, sel - 1)


def _new_profile(stdscr, data):
    outputs = get_outputs()
    if not outputs:
        flash_msg(stdscr, " Error: cannot read outputs (swaymsg) ", C_RED)
        return
    key = profile_key(outputs)
    name = text_input(stdscr, f"Name for profile [{key}]:", key)
    if name is None:
        return
    data["profiles"].setdefault(key, {
        "name": name or key,
        "outputs": {o["name"]: default_output_cfg(o) for o in outputs},
    })
    data["profiles"][key]["name"] = name or key
    save_data(data)


# ── Profile edit screen ───────────────────────────────────────────────────────

def _field_display(field, cfg):
    """Return (text, color_pair_or_0) for a field value."""
    if field == "enabled":
        return ("ON",  C_GRN) if cfg.get("enabled", True) else ("OFF", C_RED)
    if field == "x":
        return (str(cfg.get("x", 0)), 0)
    if field == "y":
        return (str(cfg.get("y", 0)), 0)
    if field == "resolution":
        if cfg.get("width") and cfg.get("height"):
            return (f"{cfg['width']}x{cfg['height']}", 0)
        return ("default", C_DIM)
    if field == "refresh_hz":
        if cfg.get("refresh_hz"):
            return (f"{cfg['refresh_hz']:.3f} Hz", 0)
        return ("auto", C_DIM)
    if field == "scale":
        return (str(cfg.get("scale", 1.0)), 0)
    return ("", 0)


def _edit_field(stdscr, field, cfg):
    if field == "enabled":
        cfg["enabled"] = not cfg.get("enabled", True)
        return
    if field == "x":
        v = text_input(stdscr, "Position X (px):", str(cfg.get("x", 0)))
        if v is not None:
            try: cfg["x"] = int(v)
            except ValueError: pass
    elif field == "y":
        v = text_input(stdscr, "Position Y (px):", str(cfg.get("y", 0)))
        if v is not None:
            try: cfg["y"] = int(v)
            except ValueError: pass
    elif field == "resolution":
        cur = f"{cfg['width']}x{cfg['height']}" if cfg.get("width") and cfg.get("height") else ""
        v = text_input(stdscr, "Resolution WxH  (blank = sway default):", cur)
        if v is not None:
            v = v.strip()
            if not v:
                cfg["width"] = cfg["height"] = None
            elif "x" in v.lower():
                parts = v.lower().split("x", 1)
                try:
                    cfg["width"]  = int(parts[0])
                    cfg["height"] = int(parts[1])
                except (ValueError, IndexError):
                    pass
    elif field == "refresh_hz":
        cur = f"{cfg['refresh_hz']:.3f}" if cfg.get("refresh_hz") else ""
        v = text_input(stdscr, "Refresh rate Hz  (blank = auto):", cur)
        if v is not None:
            v = v.strip().replace("Hz", "").strip()
            if not v:
                cfg["refresh_hz"] = None
            else:
                try: cfg["refresh_hz"] = float(v)
                except ValueError: pass
    elif field == "scale":
        v = text_input(stdscr, "Scale factor:", str(cfg.get("scale", 1.0)))
        if v is not None:
            try: cfg["scale"] = float(v)
            except ValueError: pass


def screen_edit(stdscr, data, key):
    profile  = data["profiles"][key]
    out_names = list(profile["outputs"].keys())
    n_fields  = len(FIELDS)
    out_idx   = 0
    fld_idx   = 0

    while True:
        stdscr.erase()
        h, w = stdscr.getmaxyx()
        header(stdscr, f" {profile['name']} ")
        row = 2
        for oi, out_name in enumerate(out_names):
            if row >= h - 2:
                break
            cfg = profile["outputs"][out_name]
            stdscr.attron(curses.color_pair(C_YEL) | curses.A_BOLD)
            stdscr.addstr(row, 1, out_name[:w - 2])
            stdscr.attroff(curses.color_pair(C_YEL) | curses.A_BOLD)
            row += 1
            for fi, field in enumerate(FIELDS):
                if row >= h - 2:
                    break
                label = FIELD_LABELS[field]
                val, color = _field_display(field, cfg)
                is_sel = (oi == out_idx and fi == fld_idx)
                if is_sel:
                    stdscr.attron(curses.color_pair(C_SEL) | curses.A_BOLD)
                    stdscr.addstr(row, 3, f"  {label:<16} {val}"[:w - 3])
                    stdscr.attroff(curses.color_pair(C_SEL) | curses.A_BOLD)
                else:
                    stdscr.addstr(row, 3, f"  {label:<16} ")
                    if color:
                        stdscr.attron(curses.color_pair(color))
                    stdscr.addstr(val[:max(0, w - 24)])
                    if color:
                        stdscr.attroff(curses.color_pair(color))
                row += 1
            row += 1  # blank between outputs

        footer(stdscr, [("↑↓", "Nav"), ("⏎/Spc", "Edit/Toggle"),
                        ("P", "Arrange"), ("A", "Apply"), ("S", "Save+Back"), ("Esc", "Back")])
        stdscr.refresh()
        c = stdscr.getch()

        n_out = len(out_names)
        if c == 27:
            return
        elif c == curses.KEY_UP:
            if fld_idx > 0:              fld_idx -= 1
            elif out_idx > 0:            out_idx -= 1; fld_idx = n_fields - 1
        elif c == curses.KEY_DOWN:
            if fld_idx < n_fields - 1:  fld_idx += 1
            elif out_idx < n_out - 1:   out_idx += 1; fld_idx = 0
        elif c in (ord('p'), ord('P')):
            save_data(data)
            screen_arrange(stdscr, data, key)
        elif c in (ord('s'), ord('S')):
            save_data(data)
            return
        elif c in (ord('a'), ord('A')):
            save_data(data)
            apply_profile(profile)
            flash_msg(stdscr, f" Applied: {profile['name']} ")
        elif c in (10, 13, 32):
            cfg = profile["outputs"][out_names[out_idx]]
            _edit_field(stdscr, FIELDS[fld_idx], cfg)


# ── TUI entry ─────────────────────────────────────────────────────────────────

def tui(stdscr):
    init_colors()
    curses.curs_set(0)
    data = load_data()
    while True:
        action, key = screen_profiles(stdscr, data)
        if action is None:
            break
        if action == "edit":
            screen_edit(stdscr, data, key)
        elif action == "arrange":
            screen_arrange(stdscr, data, key)
        elif action == "apply":
            profile = data["profiles"][key]
            apply_profile(profile)
            flash_msg(stdscr, f" Applied: {profile['name']} ")


# ── CLI entry ─────────────────────────────────────────────────────────────────

def main():
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--reset", "-r", action="store_true",
                    help="Delete all profiles and re-enable all outputs")
    ap.add_argument("--edit",  "-e", action="store_true",
                    help="Open TUI editor for display profiles")
    args = ap.parse_args()

    if args.edit:
        curses.wrapper(tui)
    elif args.reset:
        do_reset()
    else:
        do_apply()


if __name__ == "__main__":
    main()
