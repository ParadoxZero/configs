# Default config for sway
#
# Copy this to ~/.config/sway/config and edit it to your liking.
#
# Read `man 5 sway` for a complete reference.

### Variables
#
# Logo key. Use Mod1 for Alt. Mod4 for windows/super
set $mod Mod4
# Home row direction keys, like vim
set $left h
set $down j
set $up k
set $right l

set $term kitty
set $menu 'XDG_CURRENT_DESKTOP=sway fuzzel --terminal=kitty --filter-desktop'

# No titlebars, 2px border
default_border pixel 1
gaps inner 2
smart_gaps on
smart_borders on
focus_on_window_activation focus

client.focused          #a6e3a1 #285577 #ffffff #61afef #a6e3a1
client.unfocused        #333333 #222222 #888888 #292d2e #222222
client.focused_inactive #333333 #5f676a #ffffff #484e50 #5f676a

xwayland enable

# You can get the names of your inputs by running: swaymsg -t get_inputs
# Read `man 5 sway-input` for more information about this section.
input "type:touchpad" {
    tap enabled                  # tap-to-click
    tap_button_map lrm           # 1-finger=left, 2-finger=right, 3-finger=middle
    natural_scroll enabled       # reverse scroll direction (trackpad-style)
    scroll_method two_finger     # two-finger scrolling
    dwt enabled                  # disable touchpad while typing
    dwtp enabled                 # disable touchpad while using trackpoint (ThinkPad!)
    accel_profile adaptive       # pointer acceleration profile
    pointer_accel 0.3            # speed: -1 (slowest) to 1 (fastest)
    middle_emulation disabled
}

input "type:Mouse" {
    scroll_method on_button_down
    scroll_button button2
}

exec systemctl --user import-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP
exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=sway
exec /usr/libexec/polkit-mate-authentication-agent-1

exec swaync
exec swayosd-server
exec_always libinput-gestures
exec_always python3 ~/.config/sway/sway-display-manager
exec_always autotiling
exec_always swtchr

include /etc/sway/config-vars.d/*

### Output configuration
output * bg ~/wallpaper/current fill

# Laptop lid: disable integrated display when closed, re-enable when opened.
# On close, also suspend — but only if no external display is connected.
# Run `swaymsg -t get_outputs` to confirm your built-in display name
bindswitch --reload lid:on  output eDP-1 disable, exec ~/.config/sway/lid-suspend
bindswitch --reload lid:off output eDP-1 enable

### Idle configuration
#
# Example configuration:
#
exec swayidle -w \
         timeout 300 'swaylock -f -c 000000' 


# Set global opacity for all windows (0.0 to 1.0)
for_window [class=".*"] opacity 0.95
for_window [app_id=".*"] opacity 0.95


# Make Versa SASE client float
for_window [class="VersaSecureAccessClient"] floating enable

# Make the tagged nmtui window float, resize it, and center it
for_window [app_id="floating_tui"] {
    floating enable
    resize set 1200 px 800 px
    move position center
    border pixel 5
}

### Key bindings
#
# Basics:
#
    # Start a terminal
    bindsym $mod+Return exec $term
    # Kill focused window
    bindsym $mod+q kill
    # Start your launcher
    bindsym $mod+Space exec $menu
    # Special key to take a screenshot with grim
    bindsym Print exec grim
    bindsym $mod+p exec grim -g "$(slurp)" - | wl-copy
    # Drag floating windows by holding down $mod and left mouse button.
    # Resize them with right mouse button + $mod.
    # Despite the name, also works for non-floating windows.
    # Change normal to inverse to use left mouse button for resizing and right
    # mouse button for dragging.
    floating_modifier $mod normal
    # Reload the configuration file
    bindsym $mod+Shift+r reload
    # Display profile: apply saved profile for current output combination
    bindsym $mod+d exec python3 ~/.config/sway/sway-display-manager
    # Display profile: open TUI editor
    bindsym $mod+Shift+d exec $term --class floating_tui python3 ~/.config/sway/sway-display-manager --edit
    # Display profile: clear all profiles and re-enable all outputs
    bindsym $mod+Ctrl+Shift+d exec python3 ~/.config/sway/sway-display-manager --reset
    # Lock desktop
    bindsym $mod+Shift+Escape exec swaylock 
    # Exit sway (logs you out of your Wayland session)
    bindsym $mod+Shift+e exec swaynag -t warning -m 'You pressed the exit shortcut. Do you really want to exit sway? This will end your Wayland session.' -B 'Yes, exit sway' 'swaymsg exit'

    bindsym $mod+Tab mode swtchr; exec swtchr
    bindsym $mod+Shift+Tab mode swtchr; exec swtchr

    bindsym $mod+c exec fuzzel -l 0 --placeholder "Enter your command" --dmenu | xargs -0 -r kitty --class floating_tui sh -c

    # This is important! More information below.
    mode swtchr bindsym Backspace mode default
    
    # Notifications
    bindsym $mod+Shift+n exec swaync-client -t -sw
    bindsym $mod+t exec kitten quick-access-terminal
#
# Moving around:
#
    # Move your focus around
    bindsym $mod+$left focus left
    bindsym $mod+$down focus down
    bindsym $mod+$up focus up
    bindsym $mod+$right focus right
    # Or use $mod+[up|down|left|right]
    bindsym $mod+Left focus left
    bindsym $mod+Down focus down
    bindsym $mod+Up focus up
    bindsym $mod+Right focus right

    # Move the focused window with the same, but add Shift
    bindsym $mod+Shift+$left move left
    bindsym $mod+Shift+$down move down
    bindsym $mod+Shift+$up move up
    bindsym $mod+Shift+$right move right
    # Ditto, with arrow keys
    bindsym $mod+Shift+Left move left
    bindsym $mod+Shift+Down move down
    bindsym $mod+Shift+Up move up
    bindsym $mod+Shift+Right move right
#
# Workspaces:
#
    # Switch to workspace
    bindsym $mod+0 workspace number 0
    bindsym $mod+1 workspace number 1
    bindsym $mod+2 workspace number 2
    bindsym $mod+3 workspace number 3
    bindsym $mod+4 workspace number 4
    bindsym $mod+5 workspace number 5
    bindsym $mod+6 workspace number 6
    bindsym $mod+7 workspace number 7
    bindsym $mod+8 workspace number 8
    bindsym $mod+9 workspace number 9
    # Move focused container to workspace
    bindsym $mod+Shift+0 move container to workspace number 0
    bindsym $mod+Shift+1 move container to workspace number 1
    bindsym $mod+Shift+2 move container to workspace number 2
    bindsym $mod+Shift+3 move container to workspace number 3
    bindsym $mod+Shift+4 move container to workspace number 4
    bindsym $mod+Shift+5 move container to workspace number 5
    bindsym $mod+Shift+6 move container to workspace number 6
    bindsym $mod+Shift+7 move container to workspace number 7
    bindsym $mod+Shift+8 move container to workspace number 8
    bindsym $mod+Shift+9 move container to workspace number 9
    # Note: workspaces can have any name you want, not just numbers.
    # We just use 1-10 as the default.

      # Cycle to the next active workspace (creates new one at boundary)
    bindsym $mod+Ctrl+l exec ~/.config/sway/workspace_next.sh
    bindsym $mod+s exec ~/.config/sway/workspace_next.sh

    # Cycle to the previous active workspace (creates new one at boundary)
    bindsym $mod+Ctrl+h exec ~/.config/sway/workspace_prev.sh
    bindsym $mod+a exec ~/.config/sway/workspace_prev.sh
#
# Layout stuff:
#
    # You can "split" the current object of your focus with
    # $mod+b or $mod+v, for horizontal and vertical splits
    # respectively.
    bindsym $mod+b splith
    bindsym $mod+v splitv

    # Switch the current container between different layout styles
    bindsym $mod+Shift+s layout stacking
    bindsym $mod+Shift+w layout tabbed
    bindsym $mod+Shift+v layout toggle split

    # Make the current focus fullscreen
    bindsym $mod+f fullscreen

    # Toggle the current focus between tiling and floating mode
    bindsym $mod+Shift+space floating toggle

    # Swap focus between the tiling area and the floating area
    bindsym $mod+Ctrl+space focus mode_toggle

    # Move focus to the parent container
    bindsym $mod+Shift+a focus parent
#
# Scratchpad:
#
    # Sway has a "scratchpad", which is a bag of holding for windows.
    # You can send windows there and get them back later.

    # Move the currently focused window to the scratchpad
    bindsym $mod+Shift+minus move scratchpad

    # Show the next scratchpad window or hide the focused scratchpad window.
    # If there are multiple scratchpad windows, this command cycles through them.
    bindsym $mod+minus scratchpad show
#
# Resizing containers:
#
mode "resize" {
    # left will shrink the containers width
    # right will grow the containers width
    # up will shrink the containers height
    # down will grow the containers height
    bindsym $left resize shrink width 10px
    bindsym $down resize grow height 10px
    bindsym $up resize shrink height 10px
    bindsym $right resize grow width 10px

    # Ditto, with arrow keys
    bindsym Left resize shrink width 10px
    bindsym Down resize grow height 10px
    bindsym Up resize shrink height 10px
    bindsym Right resize grow width 10px

    # Return to default mode
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"
#
# Utilities:
#
# Special keys to adjust volume via PulseAudio
# Sink volume raise optionally with --device
bindsym XF86AudioRaiseVolume exec swayosd-client --output-volume raise
# Sink volume lower optionally with --device
bindsym XF86AudioLowerVolume exec  swayosd-client --output-volume lower 
# Sink volume toggle mute
bindsym XF86AudioMute exec swayosd-client --output-volume mute-toggle
# Source volume toggle mute
bindsym XF86AudioMicMute exec swayosd-client --input-volume mute-toggle
# Capslock (If you don't want to use the backend)
bindsym --release Caps_Lock exec swayosd-client --caps-lock
# Brightness raise (optionally with --device, can be device name or wildcard)
bindsym XF86MonBrightnessUp exec swayosd-client --brightness raise 
# Brightness lower (optionally with --device, can be device name or wildcard)
bindsym XF86MonBrightnessDown exec swayosd-client --brightness lower 
# Play/Pause current player
bindsym XF86AudioPlay exec swayosd-client --playerctl play-pause
# Next song for current player
bindsym XF86AudioNext exec swayosd-client --playerctl next

#
# Status Bar:
#
# Read `man 5 sway-bar` for more information about this section.
bar {
    position top
    swaybar_command waybar

    # When the status_command prints a new line to stdout, swaybar updates.
    # The default just shows the current date and time.
    status_command while date +'%Y-%m-%d %X'; do sleep 1; done
}

include /etc/sway/config.d/*
