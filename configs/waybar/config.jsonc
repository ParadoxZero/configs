{
  "layer": "top",
  "position": "top",
  "autohide": true,
  "autohide-blocked": false,
  "exclusive": true,
  "passthrough": false,
  "gtk-layer-shell": true,
  /* === Modules Order === */
  "modules-left": [
    "custom/waycal",
    "clock",
    "cpu",
    "memory",
    "disk",
    "temperature",
  ],
  "modules-center": [
    "idle_inhibitor",
    "sway/workspaces",
    "sway/mode",
  ],
  "modules-right": [
    "tray",
    "battery",
    "custom/volume",
    "custom/bluetooth",
    "network",
    "custom/notification",
    "custom/power"
  ],
  /* === Modules Left === */
  "custom/archicon": {
    "format": "󱗼",
    "on-click": "fuzzel --terminal=kitty",
    "tooltip": false
  },
  "custom/power": {
    "format": "",
    "on-click": "wlogout wlogout -b 6 -c 0 -r 1 -L 300 -R 300 -T 300 -B 300",
    "tooltip": false
  },
  "custom/bluetooth": {
    "format": "",
    "on-click": "kitty --class floating_tui bluetui",
    "tooltip": false
  },
  "clock": {
    "format": "{:%I:%M %p | %d-%m-%y}",
    "on-click": "xdg-open ${CALENDAR_URL:-https://outlook.cloud.microsoft/calendar/view/week}",
    "tooltip": false
  },
  "custom/waycal": {
    "format": " 󰃭 ",
    "on-click":"~/.config/waybar/waycal.sh",
    "tooltip-format": "Calendar"
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "  ",
      "deactivated": "  "
    }
  },
  "cpu": {
    "format": "{usage}% ",
    "tooltip": true,
    "tooltip-format": "CPU: {usage}%\nCores: {cores}"
  },
  "memory": {
    "format": "{}% 󰍛",
    "tooltip": true,
    "tooltip-format": "RAM Used: {used} / {total} ({percentage}%)"
  },
  "disk": {
    "format": "{percentage_used}% ",
    "tooltip": true,
    "tooltip-format": "Storage : {used} / {total} ({percentage_used}%)"
  },
  "temperature": {
    "format": "{temperatureC}°C {icon}",
    "tooltip": true,
    "tooltip-format": "Current temperature: {temperatureC}°C\nCritical > 80°C",
    "format-icons": [
      ""
    ]
  },
  /* === Modules Center === */
  "sway/workspaces": {
    "disable-scroll": true,
    "all-outputs": false,
    "format": "{name}",
  },
  /* === Modules Right === */
  "tray": {
    "icon-size": 16,
    "spacing": 6,
    "show-passive-items": true
  },
  "custom/volume": {
    "format": "",
    "on-click": "kitty --class floating_tui wiremix",
    "tooltip": false
  },
  "network": {
    "format-wifi": "",
    "format-ethernet": "󰈀",
    "format-linked": "󰈀",
    "format-disconnected": "⚠",
    "tooltip-format": "  {ifname} via {gwaddr}",
    "tooltip-format-wifi": " {essid} ({signalStrength}%)",
    "tooltip-format-ethernet": " {ifname}: {ipaddr}/{cidr}",
    "tooltip-format-disconnected": "Disconnected",
    "max-length": 50,
    "on-click": "kitty --class floating_tui  impala"
  },
  "battery": {
    "format": "{capacity}%",
    "format-charging": "{capacity}% 󱐋",
    "format-plugged": "{capacity}% ",
    "tooltip": true,
    "tooltip-format": "{timeTo} — {capacity}%",
    "format": "{capacity}% {icon}",
    "format-icons": ["", "", "", "", ""],
    "max-length": 25,
    "states": {
      "warning": 30,
      "critical": 15
    },
    "events": {
      "on-discharging-warning": "notify-send -u normal 'Low Battery'",
      "on-discharging-critical": "notify-send -u critical 'Very Low Battery'",
      "on-charging-100": "notify-send -u normal 'Battery Full!'",
      "on-discharging": "notify-send -u normal 'Power Switch' Discharging",
      "on-charging": "notify-send -u normal 'Power Switch' Charging"
    }
  },
  "custom/notification": {
    "tooltip": true,
    "format": "{icon}",
    "format-icons": {
      "notification": "󱅫",
      "none": "󰂜",
      "dnd-notification": "󰂠",
      "dnd-none": "󰪓",
      "inhibited-notification": "󰂛",
      "inhibited-none": "󰪑",
      "dnd-inhibited-notification": "󰂛",
      "dnd-inhibited-none": "󰪑"
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  }
}
